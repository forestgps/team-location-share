<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 위치. 화면이 꺼진 상태의 추적에는 BACKGROUND_LOCATION 이 반드시 필요하다. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- 포그라운드 서비스로 돌려야 화면이 꺼져도 시스템이 죽이지 않는다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 위치 없이 메시지만 받는 모드에서 쓰는 서비스 종류 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 메시지 도착 진동. 웹 화면의 navigator.vibrate 도 이 권한이 있어야 동작한다. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 메모 첨부 촬영 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      앱이 스스로 새 버전을 내려받아 설치 화면을 띄울 때 쓴다.
      스토어에 올린 앱이 아니라 자동 업데이트를 직접 해야 한다.
      설치 여부는 사용자가 확인 화면에서 결정한다(안드로이드가 무음 설치를 허용하지 않는다).
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      임무 영상·기록을 다운로드 폴더에 저장할 때 쓴다.
      안드로이드 10(API 29) 이상은 MediaStore 로 쓰므로 권한이 필요 없다.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      안드로이드 11 부터는 여기에 적어 둔 것만 다른 앱을 찾아볼 수 있다.
      적지 않으면 카메라 앱이 없는 것으로 보여서 첨부 화면에 촬영 항목이 뜨지 않는다.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 사이트 링크를 이 앱으로 열기 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="@string/launch_host"
                    android:pathPrefix="/team-location-share/" />
            </intent-filter>
        </activity>

        <service
            android:name=".TrackerService"
            android:exported="false"
            android:foregroundServiceType="location|dataSync" />

        <!-- 즉석 촬영 파일을 카메라 앱에 넘길 때 쓰는 통로. 앱 밖으로는 열려 있지 않다. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
