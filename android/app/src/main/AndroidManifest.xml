<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 위치. 화면이 꺼진 상태의 추적에는 BACKGROUND_LOCATION 이 반드시 필요하다. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- 포그라운드 서비스로 돌려야 화면이 꺼져도 시스템이 죽이지 않는다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 위치 없이 메시지만 받는 모드에서 쓰는 서비스 종류 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 메시지 도착 진동. 웹 화면의 navigator.vibrate 도 이 권한이 있어야 동작한다. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 메모 첨부 촬영 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      임무 영상·기록을 다운로드 폴더에 저장할 때 쓴다.
      안드로이드 10(API 29) 이상은 MediaStore 로 쓰므로 권한이 필요 없다.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 사이트 링크를 이 앱으로 열기 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="@string/launch_host"
                    android:pathPrefix="/team-location-share/" />
            </intent-filter>
        </activity>

        <service
            android:name=".TrackerService"
            android:exported="false"
            android:foregroundServiceType="location|dataSync" />
    </application>
</manifest>
