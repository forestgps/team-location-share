# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 저장소에 올라가지 않습니다.

# 브로커에 쓸 도메인. 이 도메인의 A 레코드가 서버 IP 를 가리켜야 합니다.
BROKER_DOMAIN=mqtt.example.com

# 인증서 만료 안내를 받을 메일 주소.
ACME_EMAIL=you@example.com

# EMQX 대시보드(관리 화면) 관리자 암호. 16자 이상 무작위로.
EMQX_DASHBOARD_PASSWORD=change-me-please

# 첨부 보관 기간. 30d, 90d 처럼 적고, 영구 보관은 0s.
RETAIN_EXPIRY=30d
